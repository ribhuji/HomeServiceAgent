# Copy to .env for a live OpenRouter demo. Never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
HOME_SERVICE_AGENT_MAX_MODEL_TURNS=3
HOME_SERVICE_AGENT_MAX_TOOL_CALLS=12
HOME_SERVICE_AGENT_MAX_WALL_SECONDS=300
# Optional OpenRouter ranking metadata:
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=HomeServiceAgent

